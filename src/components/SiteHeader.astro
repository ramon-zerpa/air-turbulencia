---
import { ArrowUpRight, ChevronDown, Menu, X } from '@lucide/astro';
import { acServices, heatingServices, pageLink, site } from '../data/site';
---
<div class="top-bar">
  <div class="container top-bar-inner">
    <span>Heating &amp; cooling for Tampa Bay</span>
    <a href={site.phoneHref}>{site.phone}</a>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Air Turbulencia home">
      <img src="/images/ac-installation-tampa-logo.png" alt="Air Turbulencia" width="740" height="268" fetchpriority="high" decoding="async" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open navigation">
      <Menu class="menu-open" size={26} aria-hidden="true" />
      <X class="menu-close" size={26} aria-hidden="true" />
    </button>
    <nav id="primary-navigation" class="primary-navigation" aria-label="Main navigation">
      <details class="services-menu">
        <summary>Services <ChevronDown size={14} aria-hidden="true" /></summary>
        <div class="services-dropdown">
          <details class="service-category" open>
            <summary>Air Conditioning <ChevronDown size={14} aria-hidden="true" /></summary>
            <ul>{acServices.map(([name, path]) => <li><a href={pageLink(path)}>{name}</a></li>)}</ul>
          </details>
          <details class="service-category" open>
            <summary>Heating <ChevronDown size={14} aria-hidden="true" /></summary>
            <ul>{heatingServices.map(([name, path]) => <li><a href={pageLink(path)}>{name}</a></li>)}</ul>
          </details>
        </div>
      </details>
      <a href={pageLink('/ac-financing-tampa/')}>Financing</a>
      <a href={pageLink('/air-turbulencia-service-area/')}>Service Area</a>
      <a href={pageLink('/about-air-turbulencia/')}>About Us</a>
      <a href={pageLink('/hvac-tips-faqs/')}>Resources</a>
      <a class="button header-action" href={pageLink('/contact/')}>Request Service <ArrowUpRight size={18} aria-hidden="true" /></a>
    </nav>
  </div>
</header>
<script is:inline>
  (() => {
  const toggle = document.querySelector('.menu-toggle');
  const navigation = document.querySelector('#primary-navigation');
  const services = document.querySelector('.services-menu');
  const serviceCategories = document.querySelectorAll('.service-category');
  const mobileNavigation = window.matchMedia('(max-width: 1099px)');
  const syncServiceCategories = () => {
    serviceCategories.forEach((category) => { category.open = !mobileNavigation.matches; });
  };
  const setOpen = (open) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    navigation?.classList.toggle('is-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  syncServiceCategories();
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (services?.open) {
      services.open = false;
      services.querySelector('summary')?.focus();
    } else if (toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (services?.open && !services.contains(event.target)) services.open = false;
    if (!document.querySelector('.site-header')?.contains(event.target)) setOpen(false);
  });
  document.addEventListener('focusin', (event) => {
    if (services?.open && event.target instanceof Node && !services.contains(event.target)) services.open = false;
  });
  navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  mobileNavigation.addEventListener('change', () => {
    setOpen(false);
    if (services) services.open = false;
    syncServiceCategories();
  });
  document.querySelector('.site-header')?.classList.add('nav-enhanced');
  })();
</script>
