---
import { getImage } from 'astro:assets';
import { acServices, heatingServices, exploreLinks, pageLink, site } from '../data/site';
import roomPoster from '../../design/airflow-source/room-poster.png';
const roomDesktopAvif = await getImage({ src: roomPoster, width: 1672, format: 'avif' });
const roomDesktopWebp = await getImage({ src: roomPoster, width: 1672, format: 'webp' });
const roomMobileAvif = await getImage({ src: roomPoster, width: 640, format: 'avif' });
const roomMobileWebp = await getImage({ src: roomPoster, width: 640, format: 'webp' });
---
<footer class="site-footer" style={`--footer-room-desktop: image-set(url('${roomDesktopAvif.src}') type('image/avif'), url('${roomDesktopWebp.src}') type('image/webp')); --footer-room-mobile: image-set(url('${roomMobileAvif.src}') type('image/avif'), url('${roomMobileWebp.src}') type('image/webp'))`}>
  <div class="container">
    <div class="footer-grid">
      <div>
        <h2 class="footer-title">Air Turbulencia</h2>
        <a href="/">Tampa Bay HVAC</a>
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <address>4023 W Cayuga St<br />Tampa, FL 33614</address>
        <nav class="footer-socials" aria-label="Social media">
          <a href="https://www.facebook.com/airturbulencia/" aria-label="Facebook" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.3.2 2.3.2v2.5h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.9l-.5 2.9h-2.4v7A10 10 0 0 0 22 12z" /></svg></a>
          <a href="https://www.instagram.com/airturbulencia/" aria-label="Instagram" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c0 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c0-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4 1.2-.1 1.6-.1 4.8-.1zm0 2c-3.2 0-3.5 0-4.7.1-1.1.1-1.7.2-2 .4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.1.4-.3 1-.4 2.1C2.7 8.5 2.7 8.8 2.7 12s0 3.5.1 4.7c.1 1.1.2 1.7.4 2 .2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.1 1 .3 2.1.4 1.2.1 1.5.1 4.6.1 3.2 0 3.5 0 4.7-.1 1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.1-.4.3-1 .4-2.1.1-1.2.1-1.5.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.1-1-.3-2.1-.4-1.2-.1-1.5-.1-4.7-.1zm0 3.4a4.4 4.4 0 1 1 0 8.8 4.4 4.4 0 0 1 0-8.8zm0 7.3a2.9 2.9 0 1 0 0-5.8 2.9 2.9 0 0 0 0 5.8zm5.6-7.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" /></svg></a>
          <a href="https://www.linkedin.com/company/air-turbulencia-inc./" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zM8.3 18H5.7V9.7h2.6V18zM7 8.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zM18.3 18h-2.6v-4c0-1-.4-1.6-1.3-1.6-.7 0-1.1.5-1.3 1-.1.2-.1.5-.1.7V18H10.4V9.7h2.5v1.1c.4-.6 1.1-1.3 2.4-1.3 1.7 0 3 1.1 3 3.5V18z" /></svg></a>
        </nav>
      </div>
      {[['AC / HVAC Services', acServices], ['Heating Services', heatingServices], ['Explore', exploreLinks]].map(([label, links]) => (
        <div>
          <h2 class="footer-title">{label}</h2>
          <ul>{(links as typeof acServices | typeof heatingServices | typeof exploreLinks).map(([name, path]) => <li><a href={pageLink(path)}>{name}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Air Turbulencia Inc. All rights reserved.</p>
      <div class="footer-policies"><a href={pageLink('/terms-conditions/')}>Terms &amp; Conditions</a><a href={pageLink('/privacy-policy/')}>Privacy Policy</a></div>
      <p class="footer-credit">Website Design By: <a href="https://www.truewebmaster.com/" target="_blank" rel="noopener noreferrer">True Webmaster</a></p>
    </div>
  </div>
</footer>
