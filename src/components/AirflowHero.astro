---
import { Picture, getImage } from 'astro:assets';
import { ArrowUpRight, Phone, Pause, Play } from '@lucide/astro';
import room from '../assets/airflow/room.png';
import curtain from '../assets/airflow/curtain.png';
import { pageLink, site } from '../data/site';
const cloth = await getImage({ src: curtain, width: 1280, format: 'webp', quality: 80 });
const clothMobile = await getImage({ src: curtain, width: 640, format: 'webp', quality: 80 });
---
<section class="air-hero" aria-labelledby="hero-title">
  <div class="air-scene" data-air-scene><div class="scene-surface"><Picture src={room} widths={[640,960,1440,1920]} formats={['avif','webp']} sizes="100vw" alt="A bright conceptual living room with air conditioning and gently flowing curtains" loading="eager" fetchpriority="high" class="room-image" /><img class="static-curtain" src={cloth.src} srcset={`${clothMobile.src} 640w, ${cloth.src} 1280w`} sizes="(max-width: 767px) 620px, 100vw" width="1672" height="940" alt="" aria-hidden="true" decoding="async" /><canvas class="air-canvas" aria-hidden="true" data-texture={cloth.src}></canvas></div></div>
  <div class="container hero-content"><p class="hero-location">AIR TURBULENCIA <span aria-hidden="true">·</span> TAMPA BAY</p><h1 id="hero-title" data-title-flow><span class="airflow-title airflow-title--ink">AC installation<br class="desktop-break" /> in Tampa.</span><br /><span class="airflow-title airflow-title--ocean">Comfort you<br class="desktop-break" /> can feel.</span></h1><p class="hero-description">Air conditioning installation, repair and maintenance for homes and businesses across Tampa Bay.</p><div class="hero-actions"><a class="button" href={pageLink('/contact/')}>Request Service <ArrowUpRight size={20} aria-hidden="true" /></a><a class="hero-phone" href={site.phoneHref}><Phone size={17} aria-hidden="true" />Call {site.phone}</a></div></div>
  <button type="button" class="motion-toggle" hidden aria-pressed="false"><Pause class="pause-icon" size={15} aria-hidden="true" /><Play class="play-icon" size={15} aria-hidden="true" /><span>Pause animations</span></button>
</section>
