---
import { Picture } from 'astro:assets';
import { ArrowUpRight, ArrowRight, Wind, Wrench, Snowflake, BuildingComplex, Plus, Phone } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import AirflowHero from '../components/AirflowHero.astro';
import repair from '../assets/repair.jpg';
import installation from '../assets/installation.jpg';
import expertiseTechnician from '../assets/expertise-technician.jpg';
import commercial from '../../design/assets/commercial.jpg';
import { faqs, pageLink, serviceAreaGroups, site } from '../data/site';
const quickServices = [
  { title: 'Installation', path: '/air-conditioning-installation-tampa/', icon: Wind },
  { title: 'Repair', path: '/ac-repair-tampa/', icon: Wrench },
  { title: 'Maintenance', path: '/ac-maintenance-tampa/', icon: Snowflake },
  { title: 'Commercial', path: '/commercial-ac-tampa/', icon: BuildingComplex },
];
const steps = [
  ['Assess your space', 'Start with a free in-home assessment. We assess heating and cooling needs before recommending a system.'],
  ['Choose the right system', 'The right size makes a difference. Find equipment suited to your space, with a clear estimate before work starts.'],
  ['Plan your installation', 'The right equipment and the right contractor. Our team handles a clean, professional installation for your home.'],
];
---
<SiteLayout>
  <AirflowHero />
  <nav class="quick-services container" aria-label="Popular services">{quickServices.map(({ title, path, icon: Icon }) => <a href={pageLink(path)}><Icon size={24} aria-hidden="true" /><span>{title}</span><ArrowUpRight size={21} aria-hidden="true" /></a>)}</nav>
  <section class="services-section section-pad" aria-labelledby="services-title"><div class="container">
    <div class="section-intro" data-reveal><h2 id="services-title" data-title-flow><span class="airflow-title airflow-title--ink">Good air.</span><br /><span class="airflow-title airflow-title--ocean ocean">Better every day.</span></h2><p>From an AC that needs attention to a fresh start with a new system, we take care of your home’s comfort.</p></div>
    <div class="service-panels">
      <article class="service-panel panel-install" data-reveal="image"><Picture src={installation} formats={['avif','webp']} widths={[480,800,1100]} sizes="(min-width: 1100px) 55vw, (min-width: 768px) 50vw, 100vw" alt="An outdoor air conditioning unit beside a home" loading="lazy" /><div class="panel-copy"><Wind size={28} aria-hidden="true" /><h3>A fresh start.<br />Built around you.</h3><p>Right-sized equipment and a professional AC installation. We recommend the system that fits your home and provide a clear estimate before work starts.</p><a class="panel-link" href={pageLink('/air-conditioning-installation-tampa/')}>Explore AC installation <ArrowUpRight size={22} aria-hidden="true" /></a></div></article>
      <article class="service-panel panel-repair" data-reveal="image" data-delay="100"><Picture src={repair} formats={['avif','webp']} widths={[480,800]} sizes="(min-width: 768px) 40vw, 100vw" alt="A technician checking air conditioning pressure gauges" loading="lazy" /><div class="panel-copy"><Wrench size={28} aria-hidden="true" /><h3>Let’s get your<br />comfort back.</h3><p>When the AC quits in the middle of a Florida afternoon, you want it corrected the first time and at a fair price. That’s the whole job for us.</p><a class="panel-link" href={pageLink('/ac-repair-tampa/')}>Explore AC repair <ArrowUpRight size={22} aria-hidden="true" /></a></div></article>
    </div>
    <div class="service-extras"><a href={pageLink('/ac-maintenance-tampa/')} data-reveal><Snowflake size={24} aria-hidden="true" /><div><h3>Keep comfort going.</h3><p>Explore AC maintenance</p></div><ArrowUpRight aria-hidden="true" /></a><a href={pageLink('/ac-emergency-tampa/')} data-reveal data-delay="90"><Phone size={24} aria-hidden="true" /><div><h3>AC needs attention?</h3><p>Ask about emergency service</p></div><ArrowUpRight aria-hidden="true" /></a></div>
  </div></section>
  <section class="process-section section-pad" aria-labelledby="process-title"><div class="container"><div class="process-heading" data-reveal><h2 id="process-title">Your next chapter<br />starts with <span class="ocean">comfort.</span></h2><a class="text-link" href={pageLink('/ac-financing-tampa/')}>Explore financing options <ArrowUpRight size={20} aria-hidden="true" /></a></div><ol class="process-steps">{steps.map(([title, body], i) => <li data-reveal data-delay={i * 100}><span class="step-number" aria-hidden="true">0{i+1}</span><h3>{title}</h3><p>{body}</p></li>)}</ol><a class="button" href={pageLink('/contact/')}>Plan your installation <ArrowUpRight size={20} aria-hidden="true" /></a></div></section>
  <section class="expertise-section dark-section section-pad" aria-labelledby="expertise-title"><div class="container expertise-grid"><div class="expertise-copy" data-reveal="side"><Wind size={40} class="amber" aria-hidden="true" /><h2 id="expertise-title">Your home.<br />Our expertise.</h2><p>We are proud to attend to the heating and cooling needs of the Tampa Bay Area and its surroundings for over 10 years.</p><p>We focus on giving every customer their money’s worth: high-quality, reliable products and a professional installation.</p><a class="text-link" href={pageLink('/about-air-turbulencia/')}>Meet Air Turbulencia <ArrowUpRight size={20} aria-hidden="true" /></a></div><div class="equipment-story"><div class="equipment-picture" data-reveal="photo"><Picture src={expertiseTechnician} formats={['avif','webp']} widths={[480,640,800]} sizes="(min-width: 1100px) 433px, (min-width: 768px) 45vw, 100vw" alt="An HVAC technician diagnosing an outdoor air conditioning condenser" loading="lazy" /></div><h3>All makes. All models.</h3><p>We service all major makes and models, using hands-on experience to diagnose issues and deliver dependable repairs.</p></div></div></section>
  <section class="more-comfort section-pad" aria-labelledby="more-title">
    <div class="container comfort-grid">
      <div class="heating-story" data-reveal="side">
        <span class="heating-symbol" aria-hidden="true"><Wind size={54}/></span>
        <h2 id="more-title">Comfort, wherever<br />life happens.</h2>
        <h3>Warmth when<br />you need it.</h3>
        <p>Our installers work across every make and model, with a free estimate to help you choose a heating system before committing.</p>
        <p>When the heat fails, our team can help with diagnosis, repair and maintenance.</p>
        <div class="heating-links">
          <a class="text-link" href={pageLink('/heating-installation-tampa/')}><span>Heating installation</span><ArrowRight size={18} aria-hidden="true" /></a>
          <a class="text-link" href={pageLink('/heating-repair-tampa/')}><span>Heating repair</span><ArrowRight size={18} aria-hidden="true" /></a>
        </div>
      </div>
      <div class="commercial-story" data-reveal="image">
        <Picture src={commercial} formats={['avif','webp']} widths={[480,800]} sizes="(min-width: 768px) 45vw, 100vw" alt="Commercial air conditioning equipment" loading="lazy" />
        <div>
          <h3>A better place<br />to do business.</h3>
          <p>Office, retail or restaurant — we install, service and replace commercial HVAC systems for your business’s heating and cooling needs.</p>
          <a class="button" href={pageLink('/commercial-ac-tampa/')}>Commercial air conditioning <ArrowUpRight size={20} aria-hidden="true" /></a>
        </div>
      </div>
    </div>
  </section>
  <section class="reviews-section section-pad" aria-labelledby="reviews-title"><div class="container"><div class="section-intro" data-reveal><h2 id="reviews-title">Comfort is personal.<br />So is our service.</h2><a class="text-link" href="https://www.google.com/search?q=Air+Turbulencia+reviews">Read Google reviews <ArrowUpRight size={20} aria-hidden="true" /></a></div><div class="review-pair"><figure data-reveal><span class="quote-mark" aria-hidden="true">“</span><blockquote>We called Angel at Air Turbulencia. Angel came to our office within a few hours, knew exactly what was wrong with our AC, and had it repaired in 20 minutes.</blockquote><figcaption>Joe Welbourn <span>Google Review</span></figcaption></figure><figure data-reveal data-delay="100"><span class="quote-mark" aria-hidden="true">“</span><blockquote>If I could give a 6-star rating I would. The owner Angel is awesome — if you need any kind of HVAC work done, call this guy. Trustworthy.</blockquote><figcaption>Andrew Semryck <span>Google Review</span></figcaption></figure></div></div></section>
  <section class="coverage-section dark-section section-pad" aria-labelledby="coverage-title"><div class="container coverage-layout"><div data-reveal><h2 id="coverage-title">Tampa Bay.<br /><span class="light-ocean">Right here for you.</span></h2><p>Heating and cooling services for Tampa Bay and its surrounding communities. Ask our team about service at your location.</p><a class="text-link" href={pageLink('/air-turbulencia-service-area/')}>View all service areas <ArrowUpRight size={20} aria-hidden="true" /></a></div><div class="towns">{serviceAreaGroups.map((group, i) => <ul data-reveal data-delay={i*80}>{group.map(city => <li>{city}</li>)}</ul>)}</div></div></section>
  <section class="questions-section section-pad" aria-labelledby="questions-title"><div class="container questions-grid"><div data-reveal><h2 id="questions-title">A little clarity.<br />A lot of comfort.</h2><p>Here are a few things worth knowing before you call.</p><a class="text-link" href={pageLink('/hvac-tips-faqs/')}>More questions &amp; answers <ArrowUpRight size={20} aria-hidden="true" /></a></div><div class="questions-list">{faqs.map(({question, answer}, i) => <details open={i === 0} data-reveal data-delay={i*70}><summary>{question}<Plus size={22} aria-hidden="true" /></summary><p>{answer}</p></details>)}</div></div></section>
  <section class="final-call" aria-labelledby="final-title"><div class="container final-inner" data-reveal><div><h2 id="final-title">Let’s make room<br />for better air.</h2><p>AC installation, repair and maintenance in Tampa Bay.<br />Your next step to a more comfortable space starts here.</p></div><div class="final-actions"><a class="button button-light" href={pageLink('/contact/')}>Request Service <ArrowUpRight size={20} aria-hidden="true" /></a><a href={site.phoneHref}>Call {site.phone}</a></div></div></section>
</SiteLayout>
<script>
  import { initMotion } from '../scripts/motion';
  initMotion();
</script>
